# Research backend the Vite dev/preview proxy forwards /research-gateway to.
RAG_BACKEND_URL=http://127.0.0.1:8000

# API key the proxy adds as X-API-Key. Server-side only: it is never sent to the browser.
# Leave unset to reuse RAG_API_KEY from backend/.env or the repository root .env.
# RAG_API_KEY=
